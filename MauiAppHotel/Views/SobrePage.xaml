<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MauiAppHotel.Views.SobrePage"
    Title="Sobre">

    <ScrollView>

        <VerticalStackLayout
            Padding="30"
            Spacing="20">

            <Frame
                CornerRadius="20"
                BackgroundColor="#1E3A5F"
                Padding="20"
                HasShadow="True">

                <VerticalStackLayout Spacing="15">

                    <Label
                        Text="Maui Hotel"
                        FontSize="30"
                        FontAttributes="Bold"
                        TextColor="White"
                        HorizontalOptions="Center" />

                    <Label
                        Text="Sistema de hospedagem desenvolvido em .NET MAUI."
                        FontSize="16"
                        TextColor="White"
                        HorizontalTextAlignment="Center" />

                </VerticalStackLayout>

            </Frame>

            <Frame
                CornerRadius="15"
                BackgroundColor="#F5F5F5"
                Padding="20">

                <VerticalStackLayout Spacing="10">

                    <Label
                        Text="Informações do Projeto"
                        FontSize="22"
                        FontAttributes="Bold"
                        TextColor="#1E3A5F" />

                    <Label
                        Text="Desenvolvedor: Ana Julia Silva de Lima"
                        FontSize="16" />

                    <Label
                        Text="Ano de Desenvolvimento: 2026"
                        FontSize="16" />

                    <Label
                        Text="Tecnologia: .NET MAUI"
                        FontSize="16" />

                    <Label
                        Text="Versão: 1.0"
                        FontSize="16" />

                </VerticalStackLayout>

            </Frame>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>