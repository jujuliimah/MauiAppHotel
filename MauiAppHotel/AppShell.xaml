<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MauiAppHotel.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:MauiAppHotel.Views">

    <FlyoutItem Title="Hospedagem">

        <ShellContent
            Title="Início"
            ContentTemplate="{DataTemplate views:ContratacaoHospedagem}" />

    </FlyoutItem>

    <FlyoutItem Title="Sobre">

        <ShellContent
            Title="Sobre o App"
            ContentTemplate="{DataTemplate views:SobrePage}" />

    </FlyoutItem>

</Shell>